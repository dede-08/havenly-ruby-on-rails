<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Havenly" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Havenly">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <% if user_signed_in? %>
      <%= link_to "Mi cuenta", edit_user_registration_path %> |
    <% if current_user.host? %>
    <%= link_to "Mis listings", host_listings_path %> |
    <% end %>
    <%= link_to "Salir", destroy_user_session_path, data: { turbo_method: :delete } %>
    <% else %>
    <%= link_to "Iniciar sesión", new_user_session_path %> |
    <%= link_to "Registrarse", new_user_registration_path %>
    <% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
