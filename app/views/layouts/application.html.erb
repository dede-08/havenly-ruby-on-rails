<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Havenly" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Havenly">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-stone-50 text-stone-800 antialiased">
    <header class="border-b border-stone-200 bg-white">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <%= link_to "Havenly", root_path, class: "text-xl font-bold tracking-tight text-teal-700" %>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
          <% if user_signed_in? %>
            <%= link_to "Mis reservas", bookings_path, class: "text-stone-600 hover:text-teal-700" %>
            <% if current_user.host? %>
              <%= link_to "Mis listings", host_listings_path, class: "text-stone-600 hover:text-teal-700" %>
            <% end %>
            <%= link_to "Mi cuenta", edit_user_registration_path, class: "text-stone-600 hover:text-teal-700" %>
            <%= button_to "Salir", destroy_user_session_path, method: :delete,
                  form: { class: "inline" }, class: "cursor-pointer text-stone-600 hover:text-teal-700" %>
          <% else %>
            <%= link_to "Iniciar sesión", new_user_session_path, class: "text-stone-600 hover:text-teal-700" %>
            <%= link_to "Registrarse", new_user_registration_path,
                  class: "rounded-lg bg-teal-600 px-4 py-2 text-white hover:bg-teal-700" %>
          <% end %>
        </div>
      </nav>
    </header>

    <% { notice: "border-teal-200 bg-teal-50 text-teal-800", alert: "border-red-200 bg-red-50 text-red-800" }.each do |type, classes| %>
      <% if flash[type].present? %>
        <div class="mx-auto mt-4 w-full max-w-6xl px-4">
          <p class="rounded-lg border px-4 py-3 text-sm <%= classes %>"><%= flash[type] %></p>
        </div>
      <% end %>
    <% end %>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-stone-200 bg-white py-6 text-center text-xs text-stone-500">
      Havenly · Proyecto de portafolio · Los pagos funcionan en modo de prueba
    </footer>
  </body>
</html>
