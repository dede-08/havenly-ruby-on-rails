<h1><%= @listing.title %></h1>

<p><%= @listing.description %></p>
<p>Precio por noche: $<%= @listing.price_per_night %></p>
<p>Dirección: <%= @listing.address %></p>

<% if user_signed_in? %>
  <%= link_to "Reservar", new_listing_booking_path(@listing) %>
<% else %>
  <%= link_to "Inicia sesión para reservar", new_user_session_path %>
<% end %>