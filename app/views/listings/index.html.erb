<% field = "w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-500 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" %>
<% label = "mb-1 block text-xs font-medium text-zinc-400" %>

<section class="mb-8">
  <h1 class="text-3xl font-bold tracking-tight">Encuentra tu próximo lugar para quedarte</h1>
  <p class="mt-1 text-zinc-400">Busca por ubicación, fechas y precio.</p>
</section>

<%= search_form_for @q, url: listings_path,
      html: { class: "mb-10 grid gap-3 rounded-2xl border border-zinc-800 bg-zinc-900 p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-4" } do |f| %>
  <div>
    <%= f.label :title_or_description_cont, "Buscar", class: label %>
    <%= f.search_field :title_or_description_cont, placeholder: "Depa, loft, casa...", class: field %>
  </div>
  <div>
    <%= label_tag :location, "Ubicación", class: label %>
    <%= text_field_tag :location, params[:location], placeholder: "Ciudad o dirección", class: field %>
  </div>
  <div>
    <%= label_tag :check_in, "Llegada", class: label %>
    <%= date_field_tag :check_in, params[:check_in], class: field %>
  </div>
  <div>
    <%= label_tag :check_out, "Salida", class: label %>
    <%= date_field_tag :check_out, params[:check_out], class: field %>
  </div>
  <div>
    <%= f.label :price_per_night_gteq, "Precio mínimo", class: label %>
    <%= f.number_field :price_per_night_gteq, placeholder: "0", class: field %>
  </div>
  <div>
    <%= f.label :price_per_night_lteq, "Precio máximo", class: label %>
    <%= f.number_field :price_per_night_lteq, placeholder: "Sin límite", class: field %>
  </div>
  <div class="flex items-end gap-3 sm:col-span-2">
    <%= f.submit "Buscar", class: "cursor-pointer rounded-lg bg-brand-600 px-6 py-2 text-sm font-semibold text-zinc-100 hover:bg-brand-700" %>
    <%= link_to "Limpiar", listings_path, class: "text-sm text-zinc-400 hover:text-zinc-100" %>
  </div>
<% end %>

<% if @listings.any? %>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @listings.each do |listing| %>
      <%= link_to listing_path(listing),
            class: "group overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 shadow-sm transition hover:border-brand-700" do %>
        <div class="aspect-[4/3] overflow-hidden bg-zinc-800">
          <% if listing.photos.attached? %>
            <%= image_tag listing.photos.first.variant(resize_to_fill: [ 800, 600 ]),
                  alt: listing.title, class: "h-full w-full object-cover transition group-hover:scale-105" %>
          <% else %>
            <div class="flex h-full w-full items-center justify-center text-zinc-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-14 w-14">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            </div>
          <% end %>
        </div>

        <div class="p-4">
          <div class="flex items-start justify-between gap-2">
            <h2 class="font-semibold leading-snug"><%= listing.title %></h2>
            <% if listing.average_rating.present? %>
              <span class="shrink-0 text-sm font-medium"><span class="text-brand-400">★</span> <%= listing.average_rating %></span>
            <% end %>
          </div>
          <p class="mt-1 line-clamp-2 text-sm text-zinc-400"><%= listing.description %></p>
          <p class="mt-3 text-sm">
            <span class="text-lg font-bold">$<%= number_with_precision(listing.price_per_night, precision: 0) %></span>
            <span class="text-zinc-500">/ noche</span>
          </p>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-2xl border border-dashed border-zinc-700 bg-zinc-900 p-12 text-center">
    <p class="font-medium">No encontramos alojamientos con esos filtros.</p>
    <%= link_to "Ver todos", listings_path, class: "mt-2 inline-block text-sm text-brand-400 hover:underline" %>
  </div>
<% end %>
